# LLM + Embedding
OPENROUTER_API_KEY=sk-or-v2-YOUR_KEY_HERE
LLM_MODEL=anthropic/claude-3.5-sonnet
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Database
POSTGRES_URL=postgresql://aios:aios_dev@postgres:5432/aios

# Vector DB
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=agent_documents

# Auth
APP_SECRET=change-me-in-production
ADMIN_PASSWORD=change-me

# Storage
UPLOAD_DIR=/app/uploads
AGENTS_DIR=/app/agents
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# App
DEBUG=true

# XPM Jarvis private runtime services (the Hermes agent runtime remains an internal adapter)
HERMES_API_BASE_URL=http://hermes:8080
HERMES_API_KEY=replace-with-private-hermes-api-key
COGNEE_BASE_URL=http://cognee:8000
COGNEE_API_KEY=replace-with-private-cognee-api-key

# ClickUp explicit-delegation webhook
# Create the webhook after production deployment and store the returned webhook.secret here.
CLICKUP_WEBHOOK_SECRET=replace-with-clickup-webhook-secret
# Product-facing explicit delegation trigger
JARVIS_CLICKUP_MENTION=@Jarvis
# Legacy compatibility only; leave unset for new deployments.
HERMES_CLICKUP_MENTION=
# Confirmed first pilot scope
CLICKUP_PILOT_SPACE_NAME=Hunter's Dojo
CLICKUP_PILOT_LIST_ID=901415896119
CLICKUP_PILOT_LIST_NAME=Live MVP Test Sprint
